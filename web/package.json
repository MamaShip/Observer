{
  "name": "observer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "openapi": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "smoke": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.65.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  }
}
