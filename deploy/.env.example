# Observer production settings (docs/design.md §13.3). Copy to .env next to
# compose.yaml, fill in, and chmod 600. Values are not quoted; they may
# contain spaces and <>.

# The site is https://DOMAIN, snapshots are served from https://snap.DOMAIN.
# Both names need DNS A records pointing at this server.
DOMAIN=ob.portkey.click

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 (changing it invalidates snapshot links already handed out)
SIGNING_KEY=

SERVICE_NAME=折光观察者
# Optional: the collection of tools this site belongs to, linked from the
# footer, the about page and the 404 page. Empty: no link.
TOOLKIT_URL=https://tools.portkey.click/
TOOLKIT_NAME=Portkey 工具集
REGISTRATION_MODE=invite
# Invitations each user may send per month in invite mode (0: only admins invite).
MONTHLY_INVITE_LIMIT=5
ADMIN_EMAILS=

# Email (Resend). The password is an API key with sending access to this domain only.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=折光观察者 <noreply@ob.portkey.click>
DAILY_EMAIL_LIMIT=100
# Notification emails per account per month (0: no limit); see observer admin email-limit.
MONTHLY_EMAIL_LIMIT=20

# Object storage (Wasabi): snapshots, images and daily database backups.
S3_ENDPOINT=s3.ap-southeast-1.wasabisys.com
S3_REGION=ap-southeast-1
S3_BUCKET=observer-backup-001
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: the WeChat Official Account entry (docs/design.md §6.7). WECHAT_TOKEN is
# the Token of the platform's server configuration (3–32 letters or digits;
# plain-text mode, URL https://DOMAIN/wechat/callback). Empty: off.
# WECHAT_ACCOUNT_ID is the original ID (gh_…), WECHAT_NAME what users follow.
WECHAT_TOKEN=
WECHAT_ACCOUNT_ID=
WECHAT_NAME=

# Optional: Healthchecks.io ping URL, and canary articles (docs/design.md §6.6).
HEALTHCHECK_URL=
CANARY_ALIVE_URL=
CANARY_DELETED_URL=

LOG_LEVEL=info
# Image to run; set by the deploy script for a specific version.
OBSERVER_IMAGE=ghcr.io/mamaship/observer:latest
